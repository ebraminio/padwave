# libFuzzer writes coverage units into the seed dirs; keep only the seeds.
/fuzz/corpus/*
!/fuzz/corpus/bt31.bin
!/fuzz/corpus/press.bin
!/fuzz/corpus/release.bin
!/fuzz/corpus/usb01.bin
!/fuzz/corpus/mic.bin
/fuzz/corpus_seq/*
!/fuzz/corpus_seq/press_release.bin
/fuzz/corpus_fields/*
!/fuzz/corpus_fields/lightbar
!/fuzz/corpus_fields/rumble
!/fuzz/corpus_fields/power
!/fuzz/corpus_fields/fade
!/fuzz/corpus_fields/bad
!/fuzz/corpus_fields/empty
/fuzz/corpus_http/*
!/fuzz/corpus_http/get_root
!/fuzz/corpus_http/get_status
!/fuzz/corpus_http/post
!/fuzz/corpus_http/huge_cl
!/fuzz/corpus_http/partial
