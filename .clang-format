# padwave's C++ style: LLVM, but 100 columns and the project's compact
# one-line guards. Keep includes in their hand-written order (the FFmpeg block
# must stay inside extern "C"). Run: clang-format -i padwave.cc *.hh
BasedOnStyle: LLVM
Language: Cpp
Standard: Latest
ColumnLimit: 100
IndentWidth: 2
TabWidth: 2
UseTab: Never
AccessModifierOffset: -2
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortCaseLabelsOnASingleLine: true
AllowShortLoopsOnASingleLine: true
BreakBeforeBraces: Attach
BreakTemplateDeclarations: Yes
PointerAlignment: Right
DerivePointerAlignment: false
SortIncludes: false
IncludeBlocks: Preserve
FixNamespaceComments: true
NamespaceIndentation: None
IndentCaseLabels: false
BinPackArguments: true
BinPackParameters: true
AlignAfterOpenBracket: Align
AlignOperands: Align
BreakBeforeBinaryOperators: None
Cpp11BracedListStyle: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always
SpaceAfterCStyleCast: false
SpacesBeforeTrailingComments: 1

# Keep enum/table assignments aligned, including across separating comments.
AlignConsecutiveAssignments: AcrossComments

# Align comments on consecutive declarations/fields.
AlignTrailingComments: true
