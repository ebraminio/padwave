[Unit]
Description=padwave — DualSense radio
After=pipewire.service wireplumber.service bluetooth.target network-online.target
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/padwave
Environment=MIX_ENV=prod
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ELIXIR_ERL_OPTIONS=+fnu
# Optional overrides (PADWAVE_ROOTS and friends), one KEY=VALUE per line.
EnvironmentFile=-%h/.config/padwave/env
ExecStart=%h/padwave/scripts/padwave-boot.sh
Restart=on-failure
RestartSec=3
# Kill the player child along with the BEAM.
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
