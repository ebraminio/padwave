[Unit]
Description=padwave — DualSense radio
After=bluetooth.target network-online.target
Wants=bluetooth.target

[Service]
Type=simple
WorkingDirectory=%h/padwave
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PADWAVE_STANDALONE=1
# Optional overrides (PADWAVE_ROOTS and friends), one KEY=VALUE per line.
EnvironmentFile=-%h/.config/padwave/env
ExecStart=%h/padwave/scripts/padwave-boot.sh
Restart=on-failure
RestartSec=3
# Kill the player/input children with the app.
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
