[Unit]
Description=padwave — DualSense radio
Documentation=https://github.com/ebrahim/padwave
After=pipewire.service wireplumber.service bluetooth.target network-online.target
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/padwave
Environment=MIX_ENV=prod
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ELIXIR_ERL_OPTIONS=+fnu
ExecStart=/usr/bin/mix run --no-halt
Restart=on-failure
RestartSec=3
# Kill mpv children along with the BEAM.
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
