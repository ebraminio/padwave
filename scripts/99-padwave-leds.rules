# Give the logged-in user write access to the DualSense lightbar.
#
# The kernel's playstation driver exposes the controller's RGB LED under
# /sys/class/leds as "inputN:rgb:indicator", but the attributes are root-owned.
# padwave paints the bar to show its state (cyan = playing, amber = paused,
# red pulse = idle warning), so it needs write access.
#
# Remove this file and re-run `udevadm control --reload-rules` to undo; padwave
# simply disables the lightbar when it cannot write.
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="input*rgb:indicator", RUN+="/bin/sh -c 'chmod 0666 /sys/class/leds/%k/brightness /sys/class/leds/%k/multi_intensity'"
