[Unit]
Description=padwave — DualSense music player
After=bluetooth.target network-online.target
Wants=bluetooth.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Optional overrides (PADWAVE_ROOTS and friends), one KEY=VALUE per line.
EnvironmentFile=-%h/.config/padwave/env
ExecStart=%h/.local/bin/padwave 8787
Restart=on-failure
RestartSec=3
# One process, one thread.
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
